-- ============================================================
local function get_ball_props()
    local ball = System_ball.get()
    if not ball then return nil end
    if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then
        return nil
    end

    local vel = ball.AssemblyLinearVelocity or Vector3.new()
    local to_ball = LocalPlayer.Character.PrimaryPart.Position - ball.Position
    local dist = to_ball.Magnitude
    local dir = dist > 0 and to_ball.Unit or Vector3.new()
    local dot = 0
    if vel.Magnitude > 0 and dist > 0 then
        dot = dir:Dot(vel.Unit)
    end
    return { Velocity = vel, Distance = dist, Direction = dir, Dot = dot }
end

local function get_entity_props()
    if not Closest_Entity or not Closest_Entity.PrimaryPart then return nil end
    if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then
        return nil
    end
    local vel = Closest_Entity.PrimaryPart.Velocity
    local dir = (LocalPlayer.Character.PrimaryPart.Position
        - Closest_Entity.PrimaryPart.Position).Unit
    local dist = (LocalPlayer.Character.PrimaryPart.Position
        - Closest_Entity.PrimaryPart.Position).Magnitude
    return { Velocity = vel, Direction = dir, Distance = dist }
end

local function autospam_loop()
    if not flags.AutoSpamEnabled then return end
    if not LocalPlayer.Character then return end

    local ball = System_ball.get()
    if not ball then return end
    if Detection.slashesoffury_active then return end

    local zoomies = ball:FindFirstChild("zoomies")
    if not zoomies then return end

    System_player.get_closest()
    if not Closest_Entity or not Closest_Entity.PrimaryPart then return end

    local ball_props = get_ball_props()
    local entity_props = get_entity_props()
    if not ball_props or not entity_props then return end

    local ping = 0
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    local ping_threshold = math.clamp(ping / 10, 1, 16)

    local ball_target = ball:GetAttribute("target")
    local target_distance = entity_props.Distance
    if zoomies.VectorVelocity.Magnitude == 0 then return end

    local distance = ball_props.Distance
    if not ball_target then return end

    local spam_accuracy = 5
    local n = ball_props.Velocity.Magnitude
    if n > 0 then
        local B = (ping_threshold or 50) * 0.7 + math.min(n / 1.2, 80)
        spam_accuracy = B
    end

    if target_distance > spam_accuracy or distance > spam_accuracy then
        return
    end

    if ball_target == LocalPlayer.Name
        and target_distance > 30 and distance > 30 then
        return
    end

    if distance <= spam_accuracy
        and System.__properties.__parries > System.__properties.__spam_threshold
    then
        if flags.AutoSpamType == "Keypress" then
            System_parry.keypress()
        else
            System_parry.execute()
            if flags.AutoSpamAnimFix and getgenv().PF then
                pcall(getgenv().PF)
            end
        end
    end
end

