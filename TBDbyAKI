local function make_button(cfg)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 46)
    btn.BackgroundColor3 = cfg.active and THEME.on or THEME.bg_soft
    btn.BackgroundTransparency = cfg.active and 0.15 or 0
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = cfg.order or 0
    btn.Parent = content
    corner(btn, 10)
    local st = stroke(btn, cfg.active and THEME.on or THEME.stroke, 0.3)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -64, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = cfg.label
    lbl.TextColor3 = THEME.text
    lbl.FontFace = THEME.font
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Center
    lbl.Parent = btn

    local stt = Instance.new("TextLabel")
    stt.Size = UDim2.new(0, 52, 1, 0)
    stt.Position = UDim2.new(1, -58, 0, 0)
    stt.BackgroundTransparency = 1
    stt.Text = cfg.active and "شغال" or "واقف"
    stt.TextColor3 = cfg.active and THEME.on or THEME.text_dim
    stt.FontFace = THEME.font_bold
    stt.TextSize = 12
    stt.TextXAlignment = Enum.TextXAlignment.Right
    stt.TextYAlignment = Enum.TextYAlignment.Center
    stt.Parent = btn

    btn.MouseButton1Down:Connect(function()
        tween(btn, 0.08, { Size = UDim2.new(1, -10, 0, 43) }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, 0.15, { Size = UDim2.new(1, -8, 0, 46) },
              Enum.EasingStyle.Back):Play()
    end)

    local ref = {
        btn = btn,
        set_active = function(active)
            btn.BackgroundColor3 = active and THEME.on or THEME.bg_soft
            btn.BackgroundTransparency = active and 0.15 or 0
            st.Color = active and THEME.on or THEME.stroke
            stt.Text = active and "شغال" or "واقف"
            stt.TextColor3 = active and THEME.on or THEME.text_dim
        end,
        set_status = function(txt, color)
            stt.Text = txt
            if color then stt.TextColor3 = color end
        end,
    }
    BTN[cfg.name] = ref
    return ref
end

