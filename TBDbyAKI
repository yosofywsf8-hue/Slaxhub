-- ============================================================
local function triggerbot_loop()
    if not flags.TriggerbotEnabled then return end
    if LocalPlayer.Character and LocalPlayer.Character.PrimaryPart
        and LocalPlayer.Character.PrimaryPart:FindFirstChild("SingularityCape")
    then return end
    if System.__triggerbot.__is_parrying
        or System.__triggerbot.__parries > System.__triggerbot.__max_parries
    then return end

    local balls = workspace:FindFirstChild("Balls")
    if not balls then return end

    for _, ball in ipairs(balls:GetChildren()) do
        if ball:IsA("BasePart")
            and ball:GetAttribute("target") == LocalPlayer.Name
            and ball:GetAttribute("realBall") then

            System.__triggerbot.__is_parrying = true
            System.__triggerbot.__parries = System.__triggerbot.__parries + 1

            System_parry.execute()

            task.delay(System.__triggerbot.__parry_delay, function()
                if System.__triggerbot.__parries > 0 then
                    System.__triggerbot.__parries =
                        System.__triggerbot.__parries - 1
                end
            end)

            task.delay(1, function()
                System.__triggerbot.__is_parrying = false
            end)
            break
        end
    end
end

