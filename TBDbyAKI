-- 10. ATTEMPT AUTOPARRY (من qst01)
-- ============================================================
attemptAutoParry = function(player15, line, object, descendant, radius, zCoordinate)
    local model = LocalPlayer.Character
    if not model or not model.PrimaryPart then return false end
    if not Alive or model.Parent ~= Alive then return false end

    if not player15 then
        player15 = System_ball and System_ball.get and System_ball.get()
    end
    if not player15 then return false end

    line = line or flags.AutoParryType

    if line == "Remote" then
        if not _PARRY_PATCH.ready then return false end
        local cell = not descendant
        if cell then
            cell = compareFunction(player15) ~= LocalPlayer.Name
        end
        if cell then return false end
        System_parry.execute()
        return true
    else
        local cell = not descendant
        if cell then
            cell = compareFunction(player15) ~= LocalPlayer.Name
        end
        if cell then return false end
        return System_animation.Input(line)
    end
end

