-- SOF GetInfo — مراقبة FuryCatch attribute و بدء timer
local function sof_get_info()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    if not flags.AbilityESPEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if char:GetAttribute("FuryCatch") == true then
                    local entry = flyteBBState.AbilityUses[player]
                    local now = workspace:GetServerTimeNow()

                    if not entry then
                        entry = {
                            Ability = "Slashes of Fury",
                            Character = char,
                            Uses = 0,
                            Started = now,
                        }
                        flyteBBState.AbilityUses[player] = entry
                    end

                    if not entry.TimerId and entry.Uses == 0 then
                        local endPosition = 3.5 - now - entry.Started
                        if 0 < endPosition then
                            local balls = workspace:FindFirstChild("Balls")
                            if balls then
                                for _, ball in ipairs(balls:GetChildren()) do
                                    if ball:GetAttribute("FuryCatch" .. char.Name) then
                                        if System_visuals.UpdateFuryTimer(
                                            ball.Name, endPosition, 3.5
                                        ) then
                                            entry.TimerId = ball.Name
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                else
                    local entry = flyteBBState.AbilityUses[player]
                    if entry and entry.Ability == "Slashes of Fury" then
                        System_visuals.ClearFury(entry)
                        flyteBBState.AbilityUses[player] = nil
                    end
                end
            end
        end
    end
end

