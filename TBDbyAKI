-- SLASHES OF FURY — Module للـ qst01
-- File: sof_fury_module.lua
-- الهدف: نقل نظام SOF من qst01 الأصلي بشكل نظيف
--        - Fury Detection (يعرف لما يبدأ CATCH)
--        - Auto Hit (يضرب باري كل ما العداد يوصل عتبة)
--        - Parry Method (Remote / VIM / Mouse Click)
--        - Fury Timer Display (Billboard يبين العداد)
--        - Fury Counter فوق البول
-- التحميل: بعد qst01 الأصلي (FlyteBB).
-- ============================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local TweenService     = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ---------- الاعتماديات من qst01 ----------
local F = getgenv().flags
if type(F) ~= "table" then
    F = {}
    getgenv().flags = F
end

local QST01_SYSTEM = getgenv().__QST01_SYSTEM
local QST01_PARRY  = getgenv().__QST01_PARRY

-- ---------- Flags الافتراضية ----------
F.FuryDetection   = F.FuryDetection or false
F.FurySpamHit     = F.FurySpamHit or false
F.FuryParryAmount = F.FuryParryAmount or 35
F.FuryParryDelay  = F.FuryParryDelay or 0.05
F.FuryParryMethod = F.FuryParryMethod or "Remote"
F.FuryAutoHit     = F.FuryAutoHit or true

-- ---------- الحالة العامة ----------
local FlyteState = getgenv().FlyteBB_State
if type(FlyteState) ~= "table" then
    FlyteState = { Connections = {} }
    getgenv().FlyteBB_State = FlyteState
end

FlyteState.FuryCatch = FlyteState.FuryCatch or false
FlyteState.FuryActive = FlyteState.FuryActive or false

-- ---------- Helpers ----------
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local left = replicatedStorage.Remotes.AbilityButtonPress

-- animation input: يستخدم VIM / Mouse Click
local function animation_input(method)
    if method == "Remote" then
        return false  -- Remote يستخدم parry.execute
    end

    if method == "VIM" then
        -- simulate click عبر VirtualInputManager
        local VIM = game:GetService("VirtualInputManager")
        if VIM then
            VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            return true
        end
    end

    if method == "Mouse Click" then
        local VIM = game:GetService("VirtualInputManager")
        if VIM then
            VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            return true
        end
    end
    return false
end

-- parry fire: يستخدم QST01_PARRY إذا موجود، وإلا VIM
local function fire_parry(method)
    if method == "Remote" then
        if QST01_PARRY and QST01_PARRY.execute then
            pcall(QST01_PARRY.execute)
            return true
        end
        return false
    end
    return animation_input(method)
end

-- ---------- Fury Timer (Billboard فوق البول) ----------
local FuryTimers = {}

local function clear_fury_timer(id)
    local t = FuryTimers[id]
    if not t then return end
    FuryTimers[id] = nil
    if t.Tween then t.Tween:Cancel() end
    if t.Gui and t.Gui.Parent then t.Gui:Destroy() end
end

local function update_fury_timer(id, current, total)
    if type(current) ~= "number" or current <= 0 then
        clear_fury_timer(id)
        return
    end

    -- نبحث عن ball باسم id
    local balls_folder = workspace:FindFirstChild("Balls")
    if not balls_folder then return end

    local ball
    for _, b in ipairs(balls_folder:GetChildren()) do
        if b.Name == id and not b:GetAttribute("realBall") then
            ball = b
            break
        end
    end
    if not ball then return end

    local template = playerGui:FindFirstChild("FuryTimer")
    if not template then return end

    local entry = FuryTimers[id]
    if entry and entry.Gui.Parent ~= ball then
        clear_fury_timer(id)
        entry = nil
    end

    if not entry then
        local gui = Instance.new("BillboardGui")
        gui.Name = "FuryCharge"
        local size = math.max(ball.Size.X, ball.Size.Y, ball.Size.Z) * 2.5
        gui.Size = UDim2.fromScale(size, size * 32 / 280)
        gui.StudsOffset = Vector3.new(0, -ball.Size.Y / 2 - 0.5, 0)
        gui.ZIndexBehavior = template.ZIndexBehavior
        gui.AlwaysOnTop = true
        gui.ClipsDescendants = false
        gui.Adornee = ball

        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.AnchorPoint = Vector2.new(0.5, 0.5)
        container.Position = UDim2.fromScale(0.5, 0.5)
        container.Size = UDim2.fromScale(1, 1)
        container.Parent = gui

        local constraint = Instance.new("UISizeConstraint")
        constraint.MinSize = Vector2.new(220, 25.142857142857142)
        constraint.MaxSize = Vector2.new(240, 27.428571428571427)
        constraint.Parent = container

        local progress = template.Selection.ProgressBar:Clone()
        progress.Size = UDim2.fromScale(0.88, 0.1890625)
        progress.Position = UDim2.fromScale(0.55, 0.5)
        progress.AnchorPoint = Vector2.new(0.5, 0.5)
        progress.UIStroke.Thickness = 1
        progress.Parent = container

        gui.Parent = ball
        entry = { Gui = gui, Fill = progress.Fill }
        FuryTimers[id] = entry
    end

    if entry.Tween then entry.Tween:Cancel() end

    entry.Fill.Size = UDim2.fromScale(math.clamp(current / (total or current), 0, 1), 1)
    local t = TweenService:Create(
        entry.Fill,
        TweenInfo.new(current, Enum.EasingStyle.Linear),
        { Size = UDim2.fromScale(0, 1) }
    )
    entry.Tween = t
    t.Completed:Once(function()
        if FuryTimers[id] == entry and entry.Tween == t then
            clear_fury_timer(id)
        end
    end)
    t:Play()
    return true
end

-- ---------- Fury Counter (فوق البول) ----------
local FuryCounters = {}

local function clear_fury_counter(ball)
    local c = FuryCounters[ball]
    if c and c.Parent then c:Destroy() end
    FuryCounters[ball] = nil
end

local function update_fury_count(ball, uses)
    -- نمسح القديم لو parent مختلف
    if FuryCounters[ball] and FuryCounters[ball].Parent ~= ball then
        clear_fury_counter(ball)
    end

    update_fury_timer(ball.Name, 0.5)

    local existing = ball:FindFirstChild("ComboCounter")
    if existing then return end

    local clone = FuryCounters[ball]
    if not clone then
        local assets = replicatedStorage:FindFirstChild("Assets")
        local template = assets and assets:FindFirstChild("ComboCounter")
        if not template then return end
        clone = template:Clone()
        clone.Parent = ball
        FuryCounters[ball] = clone
    end

    local label = clone:FindFirstChild("TextLabel")
    if not label then return end

    local scale = label:FindFirstChild("UIScale")
    if scale then scale.Scale = 1.2 end

    label.Text = tostring(uses or 0)
    label.TextColor3 = Color3.new(1, 1, 1):Lerp(
        Color3.fromHSV((1 - math.min((uses or 0) / 35, 1)) * 0.166666, 1, 1),
        math.min((uses or 0) / 5, 1)
    )
    clone.StudsOffset = Vector3.new(0, 4, 0)

    if scale then
        local t = TweenService:Create(
            scale,
            TweenInfo.new(0.333, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { Scale = 0.6 }
        )
        t:Play()
    end

    local t2 = TweenService:Create(
        clone,
        TweenInfo.new(0.666, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { StudsOffset = Vector3.new(0, 3, 0) }
    )
    t2:Play()
end

-- ---------- Fury Catch Logic ----------
-- الأصل: qst01 — handlePlayerRemoving شغالة في loop كل ما
-- ComboCounter يظهر. نحن نعمل نفس الشي.
local active_fury_connections = {}

local function clear_fury_connections()
    for _, c in ipairs(active_fury_connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(active_fury_connections)
end

local function handle_fury_catch(combo_counter)
    if not F.FuryDetection or not FlyteState.FuryCatch then return end
    if not combo_counter:IsDescendantOf(workspace) then return end

    FlyteState.FuryActive = true

    local label = combo_counter:FindFirstChildOfClass("TextLabel")
    if not label then return end

    local method = F.FuryParryMethod or "Remote"
    local initial = tonumber(label.Text) or 0
    local previous = initial

    local connection = RunService.Heartbeat:Connect(function()
        -- الخروج
        if not F.FuryDetection
            or not FlyteState.FuryCatch
            or not combo_counter:IsDescendantOf(workspace) then
            return
        end

        local current = tonumber(label.Text)
        if not current then return end

        -- Auto Hit: كل ما العداد يزيد، نضرب باري
        if current > previous then
            local diff = current - previous
            previous = current

            if F.FurySpamHit then
                -- نضرب عدد diff من الباريات
                for _ = 1, math.min(diff, 5) do
                    local os_clock = os.clock()
                    if current < (F.FuryParryAmount or 35) then
                        local ok = fire_parry(method)
                        if ok then
                            current = current + 1
                            label.Text = tostring(current)
                        end
                    end
                    -- delay بين الضربات
                    local delay_time = F.FuryParryDelay or 0.05
                    if method ~= "Remote" and delay_time > 0 then
                        task.wait(delay_time)
                    end
                end
            end
        end
    end)

    table.insert(active_fury_connections, connection)
end

-- ---------- مراقبة playerGui للأهداف ----------
local function on_fury_ball_added(ball_gui)
    if not F.FuryDetection then return end

    local key = "Fury Ball " .. ball_gui:GetDebugId()
    if FlyteState.Connections[key] then
        pcall(function() FlyteState.Connections[key]:Disconnect() end)
    end

    local existing = ball_gui:FindFirstChild("ComboCounter")
    if existing then
        task.spawn(handle_fury_catch, existing)
    end

    FlyteState.Connections[key] = ball_gui.ChildAdded:Connect(function(child)
        if child.Name == "ComboCounter" then
            handle_fury_catch(child)
        end
    end)
end

-- ---------- Fury Detection Signals ----------
-- qst01 يكتشف من: RE/SlashesOfFuryCatch و RE/SlashesOfFuryEnd
-- و input events (AbilityButtonPress + UserInputService)
local function on_fury_start()
    FlyteState.FuryCatch = true
    FlyteState.FuryActive = false
end

local function on_fury_end()
    FlyteState.FuryCatch = false
    FlyteState.FuryActive = false
    clear_fury_connections()
end

-- ربط الإشارات
local function install_fury_signals()
    -- 1. من remotes
    local net = replicatedStorage:FindFirstChild("Packages")
    net = net and net:FindFirstChild("_Index")
    net = net and net:FindFirstChild("sleitnick_net@0.1.0")
    net = net and net:FindFirstChild("net")

    if net then
        local catch = net:FindFirstChild("RE/SlashesOfFuryCatch")
        if catch then
            catch.OnClientEvent:Connect(on_fury_start)
        end

        local end_evt = net:FindFirstChild("RE/SlashesOfFuryEnd")
        if end_evt then
            end_evt.OnClientEvent:Connect(on_fury_end)
        end
    end

    -- 2. من playerGui events (كل ما ball جديد يظهر)
    playerGui.ChildAdded:Connect(on_fury_ball_added)
    for _, child in ipairs(playerGui:GetChildren()) do
        on_fury_ball_added(child)
    end

    playerGui.ChildRemoved:Connect(function(gui)
        local key = "Fury Ball " .. gui:GetDebugId()
        if FlyteState.Connections[key] then
            pcall(function() FlyteState.Connections[key]:Disconnect() end)
            FlyteState.Connections[key] = nil
        end
    end)

    -- 3. من AbilityButtonPress (بدء الـ fury)
    local function on_input_begin(input, game_processed)
        if game_processed then return end
        -- نكتشف ضغط زر Ability
        local settings = replicatedStorage:FindFirstChild("Controllers")
        settings = settings and settings:FindFirstChild("SettingsController")
        if settings then
            local ok, use_bind = pcall(function()
                local mod = require(settings)
                return mod:UseBind(input, "Ability")
            end)
            if ok and use_bind then
                -- trigger fury detection fallback
                local char = LocalPlayer.Character
                local abilities = char and char:FindFirstChild("Abilities")
                local sof = abilities and abilities:FindFirstChild("Slashes of Fury")
                if sof and sof.Enabled then
                    on_fury_start()
                end
            end
        end
    end

    pcall(function()
        local ui_mod = replicatedStorage:FindFirstChild("UserInputService")
        if ui_mod then
            local user_input = require(ui_mod)
            user_input.InputBegan:Connect(on_input_begin)
        end
    end)

    -- 4. من AbilityButtonPress (left = Remotes.AbilityButtonPress)
    if left then
        left.Event:Connect(function()
            local char = LocalPlayer.Character
            local abilities = char and char:FindFirstChild("Abilities")
            local sof = abilities and abilities:FindFirstChild("Slashes of Fury")
            if sof and sof.Enabled then
                local player_gui = LocalPlayer.PlayerGui:FindFirstChild("Hotbar")
                local ability = player_gui and player_gui:FindFirstChild("Ability")
                local red = ability and ability:FindFirstChild("Red")
                if red and not red.Visible then
                    on_fury_start()
                end
            end
        end)
    end

    -- 5. من القيمة المباشرة (RE/SlashesOfFuryActivate)
    if net then
        local activate = net:FindFirstChild("RE/SlashesOfFuryActivate")
        if activate then
            activate.OnClientEvent:Connect(function(...)
                local args = {...}
                local p = args[1]
                if p == LocalPlayer or p == LocalPlayer.Name
                    or (p and p.Name == LocalPlayer.Name) then
                    on_fury_start()
                end
            end)
        end
    end

    -- 6. من ParrySuccessAll (كل ما parry ينجح أثناء fury، نزيد العداد)
    local parry_remote = replicatedStorage:FindFirstChild("Remotes")
    parry_remote = parry_remote and parry_remote:FindFirstChild("ParrySuccessAll")
    if parry_remote then
        parry_remote.OnClientEvent:Connect(function(...)
            if not FlyteState.FuryCatch then return end
            local args = {...}
            local player_arg = args[4]
            if player_arg == LocalPlayer then
                local uses = FlyteState.AbilityUses and FlyteState.AbilityUses[LocalPlayer]
                if uses then
                    uses.Uses = math.min((uses.Uses or 0) + 1, 35)
                    local ball = workspace:FindFirstChild("Balls")
                    if ball then
                        for _, b in ipairs(ball:GetChildren()) do
                            if b.Name == LocalPlayer.Name then
                                update_fury_count(b, uses.Uses)
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
end

install_fury_signals()

-- ---------- Public API ----------
local SOF = {}

function SOF.toggle_detection(state)
    F.FuryDetection = state == true
    if not F.FuryDetection then
        on_fury_end()
    end
end

function SOF.toggle_auto_hit(state)
    F.FurySpamHit = state == true
end

function SOF.set_parry_amount(n)
    F.FuryParryAmount = math.clamp(tonumber(n) or 35, 1, 35)
end

function SOF.set_parry_delay(n)
    F.FuryParryDelay = math.clamp(tonumber(n) or 0.05, 0.02, 0.5)
end

function SOF.set_parry_method(method)
    if method == "Remote" or method == "VIM" or method == "Mouse Click" then
        F.FuryParryMethod = method
    end
end

function SOF.status()
    return {
        detection = F.FuryDetection,
        auto_hit = F.FurySpamHit,
        amount = F.FuryParryAmount,
        delay = F.FuryParryDelay,
        method = F.FuryParryMethod,
        catch = FlyteState.FuryCatch,
        active = FlyteState.FuryActive,
    }
end

-- تصدير
getgenv().__SOF_FURY = SOF

