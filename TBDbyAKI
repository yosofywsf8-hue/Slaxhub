-- Fury Timers
local FuryTimers = {}

local function clear_fury_timer(id)
    local t = FuryTimers[id]
    if not t then return end
    FuryTimers[id] = nil
    if t.Tween then t.Tween:Cancel() end
    if t.Gui and t.Gui.Parent then t.Gui:Destroy() end
end

local function update_fury_timer(id, current, total)
    if type(current) ~= "number" or current <= 0 then
        clear_fury_timer(id)
        return
    end

    local balls_folder = workspace:FindFirstChild("Balls")
    if not balls_folder then return end

    local ball
    for _, b in ipairs(balls_folder:GetChildren()) do
        if b.Name == id and not b:GetAttribute("realBall") then
            ball = b
            break
        end
    end
    if not ball then return end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local template = playerGui and playerGui:FindFirstChild("FuryTimer")
    if not template then return end

    local entry = FuryTimers[id]
    if entry and entry.Gui.Parent ~= ball then
        clear_fury_timer(id)
        entry = nil
    end

    if not entry then
        local gui = Instance.new("BillboardGui")
        gui.Name = "FuryCharge"
        local size = math.max(ball.Size.X, ball.Size.Y, ball.Size.Z) * 2.5
        gui.Size = UDim2.fromScale(size, size * 32 / 280)
        gui.StudsOffset = Vector3.new(0, -ball.Size.Y / 2 - 0.5, 0)
        gui.ZIndexBehavior = template.ZIndexBehavior
        gui.AlwaysOnTop = true
        gui.ClipsDescendants = false
        gui.Adornee = ball

        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.AnchorPoint = Vector2.new(0.5, 0.5)
        container.Position = UDim2.fromScale(0.5, 0.5)
        container.Size = UDim2.fromScale(1, 1)
        container.Parent = gui

        local constraint = Instance.new("UISizeConstraint")
        constraint.MinSize = Vector2.new(220, 25.14)
        constraint.MaxSize = Vector2.new(240, 27.43)
        constraint.Parent = container

        local progress = template.Selection.ProgressBar:Clone()
        progress.Size = UDim2.fromScale(0.88, 0.1890625)
        progress.Position = UDim2.fromScale(0.55, 0.5)
        progress.AnchorPoint = Vector2.new(0.5, 0.5)
        if progress:FindFirstChild("UIStroke") then
            progress.UIStroke.Thickness = 1
        end
        progress.Parent = container

        gui.Parent = ball
        entry = { Gui = gui, Fill = progress.Fill }
        FuryTimers[id] = entry
    end

    if entry.Tween then entry.Tween:Cancel() end

    entry.Fill.Size = UDim2.fromScale(
        math.clamp(current / (total or current), 0, 1), 1)
    local t = TweenService:Create(
        entry.Fill,
        TweenInfo.new(current, Enum.EasingStyle.Linear),
        { Size = UDim2.fromScale(0, 1) }
    )
    entry.Tween = t
    t.Completed:Once(function()
        if FuryTimers[id] == entry and entry.Tween == t then
            clear_fury_timer(id)
        end
    end)
    t:Play()
    return true
end

-- Fury Counter
local FuryCounters = {}

local function clear_fury_counter(ball)
    local c = FuryCounters[ball]
    if c and c.Parent then c:Destroy() end
    FuryCounters[ball] = nil
end

local function update_fury_count(ball, uses)
    if FuryCounters[ball] and FuryCounters[ball].Parent ~= ball then
        clear_fury_counter(ball)
    end

    update_fury_timer(ball.Name, 0.5)

    local existing = ball:FindFirstChild("ComboCounter")
    if existing then return end

    local clone = FuryCounters[ball]
    if not clone then
        local assets = replicatedStorage:FindFirstChild("Assets")
        local template = assets and assets:FindFirstChild("ComboCounter")
        if not template then return end
        clone = template:Clone()
        clone.Parent = ball
        FuryCounters[ball] = clone
    end

    local label = clone:FindFirstChild("TextLabel")
    if not label then return end

    local scale = label:FindFirstChild("UIScale")
    if scale then scale.Scale = 1.2 end

    label.Text = tostring(uses or 0)
    label.TextColor3 = Color3.new(1, 1, 1):Lerp(
        Color3.fromHSV((1 - math.min((uses or 0) / 35, 1)) * 0.166666, 1, 1),
        math.min((uses or 0) / 5, 1)
    )
    clone.StudsOffset = Vector3.new(0, 4, 0)

    if scale then
        local t = TweenService:Create(
            scale,
            TweenInfo.new(0.333, Enum.EasingStyle.Sine,
                Enum.EasingDirection.InOut),
            { Scale = 0.6 }
        )
        t:Play()
    end

    local t2 = TweenService:Create(
        clone,
        TweenInfo.new(0.666, Enum.EasingStyle.Sine,
            Enum.EasingDirection.InOut),
        { StudsOffset = Vector3.new(0, 3, 0) }
    )
    t2:Play()
end

-- Fury catch connections
local active_fury_connections = {}

local function clear_fury_connections()
    for _, c in ipairs(active_fury_connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(active_fury_connections)
end

local function fire_parry(method)
    if method == "Remote" then
        pcall(System_parry.execute)
        return true
    end
    return vim_click(method)
end

local function handle_fury_catch(combo_counter)
    if not F.FuryDetection or not FlyteState.FuryCatch then return end
    if not combo_counter:IsDescendantOf(workspace) then return end

    FlyteState.FuryActive = true

    local label = combo_counter:FindFirstChildOfClass("TextLabel")
    if not label then return end

    local method = F.FuryParryMethod or "Remote"
    local previous = tonumber(label.Text) or 0

    local connection = RunService.Heartbeat:Connect(function()
        if not F.FuryDetection
            or not FlyteState.FuryCatch
            or not combo_counter:IsDescendantOf(workspace) then
            return
        end

        local current = tonumber(label.Text)
        if not current then return end

        if current > previous then
            local diff = current - previous
            previous = current

            if F.FurySpamHit then
                for _ = 1, math.min(diff, 5) do
                    if current < (F.FuryParryAmount or 35) then
                        local ok = fire_parry(method)
                        if ok then
                            current = current + 1
                            label.Text = tostring(current)
                        end
                    end
                    local delay_time = F.FuryParryDelay or 0.05
                    if method ~= "Remote" and delay_time > 0 then
                        task.wait(delay_time)
                    end
                end
            end
        end
    end)

    table.insert(active_fury_connections, connection)
end

local function on_fury_ball_added(ball_gui)
    if not F.FuryDetection then return end

    local key = "Fury Ball " .. ball_gui:GetDebugId()
    if FlyteState.Connections[key] then
        pcall(function() FlyteState.Connections[key]:Disconnect() end)
    end

    local existing = ball_gui:FindFirstChild("ComboCounter")
    if existing then
        task.spawn(handle_fury_catch, existing)
    end

    FlyteState.Connections[key] =
        ball_gui.ChildAdded:Connect(function(child)
            if child.Name == "ComboCounter" then
                handle_fury_catch(child)
            end
        end)
end

local function on_fury_start()
    FlyteState.FuryCatch = true
    FlyteState.FuryActive = false
end

local function on_fury_end()
    FlyteState.FuryCatch = false
    FlyteState.FuryActive = false
    clear_fury_connections()
end

local function install_fury_signals()
    pcall(function()
        local net = ReplicatedStorage.Packages._Index["sleitnick_net@0.1.0"].net
        net["RE/SlashesOfFuryCatch"].OnClientEvent:Connect(on_fury_start)
        net["RE/SlashesOfFuryEnd"].OnClientEvent:Connect(on_fury_end)
        net["RE/SlashesOfFuryActivate"].OnClientEvent:Connect(function(...)
            local args = {...}
            local p = args[1]
            if p == LocalPlayer or p == LocalPlayer.Name
                or (p and p.Name == LocalPlayer.Name) then
                on_fury_start()
            end
        end)
    end)

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        playerGui.ChildAdded:Connect(on_fury_ball_added)
        for _, child in ipairs(playerGui:GetChildren()) do
            on_fury_ball_added(child)
        end
        playerGui.ChildRemoved:Connect(function(gui)
            local key = "Fury Ball " .. gui:GetDebugId()
            if FlyteState.Connections[key] then
                pcall(function()
                    FlyteState.Connections[key]:Disconnect()
                end)
                FlyteState.Connections[key] = nil
            end
        end)
    end
end

install_fury_signals()

