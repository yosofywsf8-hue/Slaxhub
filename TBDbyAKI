-- 9. PARRY EXECUTE (multi-target)
-- ============================================================
local System_parry = {}

function System_parry.execute()
    if System.__properties.__parries > 10000
        or not LocalPlayer.Character then
        return
    end
    if not _PARRY_PATCH.ready then return end

    local camera = workspace.CurrentCamera
    local ok, mouse = pcall(function()
        return UserInputService:GetMouseLocation()
    end)
    if not ok then return end

    local screenPositions = {}
    local function add(entity, root)
        if not entity or not root then return end
        local ok2, sp = pcall(function()
            return camera:WorldToScreenPoint(root.Position)
        end)
        if ok2 then screenPositions[entity.Name] = sp end
    end

    if Alive then
        for _, entity in ipairs(Alive:GetChildren()) do
            if entity ~= LocalPlayer.Character then
                add(entity, entity.PrimaryPart
                    or entity:FindFirstChild("HumanoidRootPart"))
            end
        end
    end

    local Dead = workspace:FindFirstChild("Dead")
    if Dead then
        for _, entity in ipairs(Dead:GetChildren()) do
            add(entity, entity.PrimaryPart
                or entity:FindFirstChild("HumanoidRootPart"))
        end
    end

    local TrainingBalls = workspace:FindFirstChild("TrainingBalls")
    if TrainingBalls then
        for _, entity in ipairs(TrainingBalls:GetChildren()) do
            add(entity, entity.PrimaryPart
                or entity:FindFirstChild("HumanoidRootPart"))
        end
    end

    local curveCF = System_curve.get_cframe() or camera.CFrame
    local mouseLocation
    if System.__properties.__is_mobile then
        local vp = camera.ViewportSize
        mouseLocation = {vp.X / 2, vp.Y / 2}
    else
        mouseLocation = {mouse.X, mouse.Y}
    end

    _PARRY_PATCH.fire(curveCF, screenPositions, mouseLocation)

    System.__properties.__parries = System.__properties.__parries + 1
    task.delay(0.5, function()
        if System.__properties.__parries > 0 then
            System.__properties.__parries = System.__properties.__parries - 1
        end
    end)
end

function System_parry.keypress()
    if System.__properties.__parries > 10000
        or not LocalPlayer.Character then
        return
    end
    if getgenv().PF then pcall(getgenv().PF) end
    System.__properties.__parries = System.__properties.__parries + 1
    task.delay(0.5, function()
        if System.__properties.__parries > 0 then
            System.__properties.__parries = System.__properties.__parries - 1
        end
    end)
end

