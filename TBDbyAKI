function System_animation.Input(method, flag)
    if method == "Remote" then
        return false
    end
    if method == "VIM" then
        return System_animation.VIM(flag)
    end
    if method == "Mouse Click" then
        local VIM = game:GetService("VirtualInputManager")
        if VIM then
            pcall(function()
                VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
            return true
        end
    end
    return false
end

