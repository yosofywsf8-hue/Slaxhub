engine_ref.btn.MouseButton1Click:Connect(function()
    STATE.engine = (STATE.engine == "qst01") and "azure" or "qst01"
    getgenv().__PARRY_ACTIVE_ENGINE = STATE.engine
    refresh_engine()
end)

-- 7.2 AutoParry
local autoparry_ref = make_button({
    name  = "AutoParry",
    label = "AutoParry",
    order = 2,
    active = STATE.auto_parry,
})

autoparry_ref.btn.MouseButton1Click:Connect(function()
    if not has_parry() then
        autoparry_ref.set_status_text("ناقص", THEME.error)
        return
    end
    STATE.auto_parry = not STATE.auto_parry
    System.__properties.__autoparry_enabled = STATE.auto_parry

    -- تشغيل أو إيقاف حلقة الباري
    if STATE.auto_parry then
        if System.autoparry and System.autoparry.start then
            pcall(System.autoparry.start)
        end
    else
        if System.autoparry and System.autoparry.stop then
            pcall(System.autoparry.stop)
        end
    end

    autoparry_ref.update(STATE.auto_parry)
end)

-- 7.3 AutoSpam
local autospam_ref = make_button({
    name  = "AutoSpam",
    label = "AutoSpam",
    order = 3,
    active = STATE.auto_spam,
})

autospam_ref.btn.MouseButton1Click:Connect(function()
    if not has_autospam() then
        autospam_ref.set_status_text("ناقص", THEME.error)
        return
    end
    STATE.auto_spam = not STATE.auto_spam

    local toggle = getgenv().__AZURE_AUTOSPAM_TOGGLE
    if toggle then
        pcall(toggle, STATE.auto_spam)
    end

    autospam_ref.update(STATE.auto_spam)
end)

-- 7.4 Manual Spam
local manual_ref = make_button({
    name  = "ManualSpam",
    label = "Manual Spam",
    order = 4,
    active = STATE.manual_spam,
})

manual_ref.btn.MouseButton1Click:Connect(function()
    if not has_parry() then
        manual_ref.set_status_text("ناقص", THEME.error)
        return
    end
    STATE.manual_spam = not STATE.manual_spam

    -- Manual spam = استدعاء execute من heartbeat
    if STATE.manual_spam then
        if getgenv().__AZURE_MANUAL_CONN then
            pcall(function() getgenv().__AZURE_MANUAL_CONN:Disconnect() end)
        end
        getgenv().__AZURE_MANUAL_CONN = RunService.Heartbeat:Connect(function()
            if not STATE.manual_spam then return end
            if not LocalPlayer.Character then return end
            pcall(System_parry.execute)
        end)
    else
        if getgenv().__AZURE_MANUAL_CONN then
            pcall(function() getgenv().__AZURE_MANUAL_CONN:Disconnect() end)
            getgenv().__AZURE_MANUAL_CONN = nil
        end
    end

    manual_ref.update(STATE.manual_spam)
end)

-- 7.5 Triggerbot (اختياري — إذا النظام موجود)
local triggerbot_ref = make_button({
    name  = "Triggerbot",
    label = "Triggerbot",
    order = 5,
    active = STATE.triggerbot,
})

triggerbot_ref.btn.MouseButton1Click:Connect(function()
    local tb = getgenv().features
    if tb and tb.Triggerbot and tb.Triggerbot.SetEnabled then
        STATE.triggerbot = not STATE.triggerbot
        pcall(tb.Triggerbot.SetEnabled, STATE.triggerbot)
        triggerbot_ref.update(STATE.triggerbot)
    else
        triggerbot_ref.set_status_text("ناقص", THEME.warn)
    end
end)

-- 7.6 زر إيقاف الكل
local stop_all = make_button({
    name  = "StopAll",
    label = "أوقف الكل",
    order = 99,
    active = false,
})

stop_all.btn.MouseButton1Click:Connect(function()
    -- AutoParry
    STATE.auto_parry = false
    if System and System.__properties then
        System.__properties.__autoparry_enabled = false
        if System.autoparry and System.autoparry.stop then
            pcall(System.autoparry.stop)
        end
    end
    autoparry_ref.update(false)

    -- AutoSpam
    STATE.auto_spam = false
    if getgenv().__AZURE_AUTOSPAM_TOGGLE then
        pcall(getgenv().__AZURE_AUTOSPAM_TOGGLE, false)
    end
    autospam_ref.update(false)

    -- Manual Spam
    STATE.manual_spam = false
    if getgenv().__AZURE_MANUAL_CONN then
        pcall(function() getgenv().__AZURE_MANUAL_CONN:Disconnect() end)
        getgenv().__AZURE_MANUAL_CONN = nil
    end
    manual_ref.update(false)

    -- Triggerbot
    STATE.triggerbot = false
    local tb = getgenv().features
    if tb and tb.Triggerbot and tb.Triggerbot.SetEnabled then
        pcall(tb.Triggerbot.SetEnabled, false)
    end
    triggerbot_ref.update(false)

    stop_all.set_status_text("تمام", THEME.accent_on)
    task.delay(1.5, function()
        stop_all.set_status_text("واقف", THEME.text_dim)
    end)
end)

-- ---------- 8. السحب والإفلات (Drag) ----------
local dragging = false
local drag_start = nil
local panel_start = nil

local function is_in_header(pos)
    local abs = header.AbsolutePosition
    local size = header.AbsoluteSize
    return pos.X >= abs.X and pos.X <= abs.X + size.X
       and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        drag_start = input.Position
        panel_start = panel.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local delta = input.Position - drag_start
    panel.Position = UDim2.new(
        panel_start.X.Scale,
        panel_start.X.Offset + delta.X,
        panel_start.Y.Scale,
        panel_start.Y.Offset + delta.Y
    )
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- ---------- 9. زر التعليق ----------
local panel_open = true

local function set_open(state)
    panel_open = state
    if state then
        panel.Visible = true
        panel.Size = UDim2.new(0, 260, 0, 100)  -- نبدأ صغير
        tween(panel, 0.3, { Size = UDim2.new(0, 260, 0, 400) },
              Enum.EasingStyle.Back):Play()
        tween(toggle_btn, 0.25, { BackgroundColor3 = THEME.bg }):Play()
    else
        tween(panel, 0.25, { Size = UDim2.new(0, 260, 0, 40) }):Play()
        task.delay(0.25, function()
            if not panel_open then
                panel.Visible = false
            end
        end)
        tween(toggle_btn, 0.25, { BackgroundColor3 = THEME.bg_soft }):Play()
    end
end

toggle_btn.MouseButton1Click:Connect(function()
    set_open(not panel_open)
end)

close_btn.MouseButton1Click:Connect(function()
    set_open(false)
end)

-- ---------- 10. مزامنة تلقائية كل نصف ثانية ----------
task.spawn(function()
    while screen and screen.Parent do
        task.wait(0.5)

        -- AutoParry
        if System and System.__properties then
            local real = System.__properties.__autoparry_enabled
            if real ~= nil and real ~= STATE.auto_parry then
                STATE.auto_parry = real
                autoparry_ref.update(real)
            end
        end

        -- AutoSpam
        if AUTOSPAM_CFG then
            if AUTOSPAM_CFG.enabled ~= STATE.auto_spam then
                STATE.auto_spam = AUTOSPAM_CFG.enabled
                autospam_ref.update(STATE.auto_spam)
            end
        end

        -- Engine
        local eng = getgenv().__PARRY_ACTIVE_ENGINE
        if eng and eng ~= STATE.engine then
            STATE.engine = eng
            refresh_engine()
        end
    end
end)

-- ---------- 11. تصدير ----------
getgenv().__MOBILE_UI = {
    screen  = screen,
    panel   = panel,
    toggle  = toggle_btn,
    open    = function() set_open(true) end,
    close   = function() set_open(false) end,
    destroy = function() screen:Destroy() end,
}

