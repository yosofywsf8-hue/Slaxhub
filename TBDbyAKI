    name  = "Engine",
    label = "محرك الباري",
    order = 1,
    active = STATE.engine == "qst01",
})

local function refresh_engine()
    local eng = STATE.engine
    engine_ref.update(eng == "qst01", eng == "qst01" and "qst01" or "azure")
    engine_ref.status.TextColor3 = THEME.warn
end
