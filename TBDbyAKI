-- PART 9: AUTO PARRY LOOP
-- ============================================================
local function parry_loop()
    if not F.AutoParryEnabled then return end
    if not LocalPlayer.Character
        or not LocalPlayer.Character.PrimaryPart then return end
    if System.__properties.__parried then return end

    local balls_folder = workspace:FindFirstChild("Balls")
    if not balls_folder then return end

    local target_ball
    for _, ball in ipairs(balls_folder:GetChildren()) do
        if ball:GetAttribute("realBall") then
            ball.CanCollide = false
            target_ball = ball
            break
        end
    end
    if not target_ball then return end

    if Detection.infinity_active then return end
    if Detection.deathslash_active then return end
    if Detection.timehole_active then return end
    if Detection.slashesoffury_active then return end

    local zoomies = target_ball:FindFirstChild("zoomies")
    if not zoomies then return end

    local ball_target = target_ball:GetAttribute("target")
    if ball_target ~= LocalPlayer.Name then return end

    local velocity = zoomies.VectorVelocity or Vector3.new()
    local speed = velocity.Magnitude
    if speed < 0.001 then return end

    local root = LocalPlayer.Character.PrimaryPart
    local distance = (root.Position - target_ball.Position).Magnitude

    local ping = 0
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 10
    end)
    local ping_threshold = math.clamp(ping / 10, 5, 17)
    local capped_speed_diff = math.min(math.max(speed - 9.5, 0), 650)
    local speed_divisor = (2.4 + capped_speed_diff * 0.002)
        * System.__properties.__divisor_multiplier
    local parry_accuracy = ping_threshold
        + math.max(speed / speed_divisor, 9.5)

    if distance <= parry_accuracy then
        System_parry.execute()
        System.__properties.__parried = true
        task.delay(0.3, function()
            System.__properties.__parried = false
        end)
    end
end

