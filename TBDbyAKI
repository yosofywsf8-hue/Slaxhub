-- ---------- 6. صانع الأزرار ----------
local button_refs = {}

local function make_button(cfg)
    local btn = Instance.new("TextButton")
    btn.Name = cfg.name or "Btn"
    btn.Size = UDim2.new(1, -8, 0, 46)
    btn.BackgroundColor3 = cfg.active and THEME.accent_on or THEME.bg_soft
    btn.BackgroundTransparency = cfg.active and 0.15 or 0
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = cfg.order or 0
    btn.Parent = content
    corner(btn, 10)
    local st = stroke(btn, cfg.active and THEME.accent_on or THEME.stroke, 0.3)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = cfg.label or "Button"
    label.TextColor3 = THEME.text
    label.FontFace = THEME.font
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = btn

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(0, 48, 1, 0)
    status.Position = UDim2.new(1, -54, 0, 0)
    status.BackgroundTransparency = 1
    status.Text = cfg.active and "شغال" or "واقف"
    status.TextColor3 = cfg.active and THEME.accent_on or THEME.text_dim
    status.FontFace = THEME.font_bold
    status.TextSize = 12
    status.TextXAlignment = Enum.TextXAlignment.Right
    status.TextYAlignment = Enum.TextYAlignment.Center
    status.Parent = btn

    -- لمعة عند الضغط
    btn.MouseButton1Down:Connect(function()
        tween(btn, 0.08, { Size = UDim2.new(1, -10, 0, 43) }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, 0.15, { Size = UDim2.new(1, -8, 0, 46) },
              Enum.EasingStyle.Back):Play()
    end)

    local ref = {
        btn    = btn,
        label  = label,
        status = status,
        stroke = st,
        update = function(active, status_text)
            btn.BackgroundColor3 = active and THEME.accent_on or THEME.bg_soft
            btn.BackgroundTransparency = active and 0.15 or 0
            st.Color = active and THEME.accent_on or THEME.stroke
            status.Text = status_text or (active and "شغال" or "واقف")
            status.TextColor3 = active and THEME.accent_on or THEME.text_dim
        end,
        set_status_text = function(txt, color)
            status.Text = txt
            if color then status.TextColor3 = color end
        end,
    }
    button_refs[cfg.name] = ref
    return ref
end

